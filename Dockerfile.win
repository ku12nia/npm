FROM jenkins/jenkins
USER root

# Parameter -o Acquire::Check-Valid-Until=false -o Acquire::Check-Date=false => akan memutus blokir validasi tanggal GPG pada apt-get sehingga proses pembentukan image npm-jenkins berjalan sampai selesai.
RUN apt-get -o Acquire::Check-Valid-Until=false -o Acquire::Check-Date=false update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

ENV NEXUS_RAW_URL="http://host.docker.internal:8082/repository/raw-binaries"

# 1. Install Static Docker CLI => https://download.docker.com/linux/static/stable/x86_64/docker-24.0.9.tgz
# COPY bin/docker-24.0.9.tgz /tmp/docker.tgz
RUN curl -sSL -o /tmp/docker.tgz ${NEXUS_RAW_URL}/docker-24.0.9.tgz && \
    tar -xzf /tmp/docker.tgz -C /tmp && \
    mv /tmp/docker/docker /usr/bin/docker && \
    chmod +x /usr/bin/docker && \
    rm -rf /tmp/docker /tmp/docker.tgz

# 2. Install the Docker Buildx plugin permanently => https://github.com/docker/buildx/releases/download/v0.14.0/buildx-v0.14.0.linux-amd64
# COPY bin/buildx-v0.14.0.linux-amd64 /root/.docker/cli-plugins/docker-buildx
RUN mkdir -p /root/.docker/cli-plugins && \
    curl -sSL -o /root/.docker/cli-plugins/docker-buildx ${NEXUS_RAW_URL}/buildx-v0.14.0.linux-amd64 && \
    chmod +x /root/.docker/cli-plugins/docker-buildx

# 3. Install Kubectl => https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl
# COPY bin/kubectl /usr/local/bin/kubectl
RUN curl -sSL -o /usr/local/bin/kubectl ${NEXUS_RAW_URL}/kubectl && \
    chmod +x /usr/local/bin/kubectl

# 4. Install ArgoCD CLI => https://github.com/argoproj/argo-cd/releases/download/${ARGOCD_VERSION}/argocd-linux-amd64
# COPY bin/argocd-linux-amd64 /usr/local/bin/argocd
RUN curl -sSL -o /usr/local/bin/argocd ${NEXUS_RAW_URL}/argocd-linux-amd64 && \
    chmod +x /usr/local/bin/argocd